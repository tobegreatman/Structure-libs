                ]
              },
              "catalyst": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sustainability": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bear_case": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "leaders": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "leader",
                    "core",
                    "follower",
                    null
                  ]
                },
                "chg_20d": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "turnover_yi": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
