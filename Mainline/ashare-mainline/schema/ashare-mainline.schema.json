                    "policy",
                    "industry",
                    "earnings",
                    "event",
                    "liquidity"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "date": {
                  "type": "string",
